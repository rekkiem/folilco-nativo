# ============================================================
# FOLILCO NATIVO - Variables de Entorno
# Copia este archivo como .env.local para desarrollo
# NUNCA subas .env.local a git
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# --- MercadoPago ---
# https://www.mercadopago.cl/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token
MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key
# Secret generado en el panel de Webhooks de la app (mín. 16 chars)
MERCADOPAGO_WEBHOOK_SECRET=genera-una-clave-aleatoria-segura-aqui

# --- Twilio (WhatsApp) — opcional ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Sheets — opcional ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=folilco@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu-clave-privada\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-contrasena-fuerte
# Mínimo 32 caracteres aleatorios
JWT_SECRET=genera-un-secret-muy-largo-y-aleatorio-aqui-min-32

# --- URLs ---
NEXT_PUBLIC_BASE_URL=http://localhost:3003
# En producción: https://folilco-nativo.vercel.app

# --- Cron (obligatorio en producción) ---
CRON_SECRET=otro-secret-aleatorio-para-cron-min-16

# --- Demo solo en desarrollo (nunca en production) ---
# ALLOW_DEMO=true

# --- Turnstile (opcional, anti-abuso) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
