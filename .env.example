# ============================================================
# FOLILCO NATIVO - Variables de Entorno
# Copia este archivo como .env.local para desarrollo
# NUNCA subas .env.local a git
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# --- MercadoPago ---
# Obtener en: https://www.mercadopago.cl/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token
MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key
# Clave secreta para verificar webhooks (la generas tú, mínimo 32 chars)
MERCADOPAGO_WEBHOOK_SECRET=genera-una-clave-aleatoria-segura-aqui

# --- Twilio (WhatsApp) ---
# Obtener en: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Sheets ---
# 1. Crear Service Account en Google Cloud Console
# 2. Descargar JSON de credenciales
# 3. Copiar los valores aquí
GOOGLE_SERVICE_ACCOUNT_EMAIL=folilco@tu-proyecto.iam.gserviceaccount.com
# La clave privada: reemplaza los saltos de línea con \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu-clave-privada\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# --- Admin Dashboard ---
# Usuario y contraseña para el panel de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-contrasena-fuerte
# Secret para firmar JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=genera-un-secret-muy-largo-y-aleatorio-aqui

# --- URLs ---
NEXT_PUBLIC_BASE_URL=https://folilco.com
# Para desarrollo local:
# NEXT_PUBLIC_BASE_URL=http://localhost:3003

# --- Vercel Cron (proteger el endpoint de cron) ---
CRON_SECRET=otro-secret-aleatorio-para-cron

# --- Opcional: sensor ESP8266 ---
# IOT_SENSOR_TOKEN=token-para-el-sensor
